		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"drizzle-kit": "1.0.0-beta.2-f9236e3",
		"drizzle-orm": "1.0.0-beta.2-f9236e3",
		"embla-carousel-react": "^8.6.0",
		"globals": "16.5.0",
		"hono": "4.10.7",
