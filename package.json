		"@tanstack/router-plugin": "^1.168.32",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.29",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/zod-adapter": "^1.167.0",
