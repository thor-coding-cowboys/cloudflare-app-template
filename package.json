{
	"name": "@coding-cowboys/cloudflare-worker-app",
	"version": "0.0.0",
	"devDependencies": {
		"oxfmt": "^0.17.0",
		"oxlint": "^0.17.0",
		"turbo": "^2.10.10",
		"typescript": "^7.0.2",
		"wrangler": "4.124.0"
	},
	"cloudflare": {
		"label": "Cloudflare App",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_image_url": "https://example.com/icon.png",
		"publish": true
	},
	"packageManager": "bun@1.3.8",
	"private": true,
	"scripts": {
		"setup": "bun run scripts/setup.ts",
		"build": "turbo run build",
		"predev": "bun db:migrate",
		"dev": "turbo run dev",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "oxlint --fix .",
		"lint:check": "oxlint .",
		"fmt": "oxfmt . *.md",
		"fmt:check": "oxfmt --check . *.md",
		"check": "bun typecheck && bun lint:check && bun fmt:check",
		"prepare": "bun scripts/git-hooks/install.ts && bun --cwd apps/void scripts/link-drizzle-orm.ts",
		"wrangler-typecheck": "turbo run wrangler-typecheck",
		"db:generate": "bun --cwd apps/worker db:generate",
		"db:migrate": "bun --cwd apps/worker db:migrate",
		"db:clean": "bun --cwd apps/worker db:clean",
		"db:reset": "bun --cwd apps/worker db:reset",
		"db:seed": "bun --cwd apps/worker db:seed",
		"db:migrate:prod": "bun --cwd apps/worker db:migrate:prod",
		"db:studio": "bun --cwd apps/worker db:studio",
		"deploy": "bun --cwd apps/worker deploy",
		"cf-typegen": "bun --cwd apps/worker cf-typegen",
		"void:dev": "bun --cwd apps/void dev",
		"void:build": "bun --cwd apps/void build",
		"void:db:generate": "bun --cwd apps/void db:generate",
		"void:db:migrate": "bun --cwd apps/void db:migrate",
		"void:db:seed": "bun --cwd apps/void db:seed",
		"void:db:studio": "bun --cwd apps/void db:studio",
		"void:deploy": "bun --cwd apps/void deploy"
	},
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
