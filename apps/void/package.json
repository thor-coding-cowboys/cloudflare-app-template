		"db:push": "bun scripts/link-drizzle-orm.ts && void db push",
		"db:seed": "void db seed",
		"db:reset": "void db reset",
		"db:status": "bun scripts/link-drizzle-orm.ts && void db status",
		"db:studio": "bun scripts/link-drizzle-orm.ts && void db studio",
		"deploy": "bun scripts/link-drizzle-orm.ts && void deploy --platform cloudflare",
