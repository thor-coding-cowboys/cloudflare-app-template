{
	"name": "@coding-cowboys/cloudflare-worker-app-worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./trpc": "./src/trpc-router.ts",
		"./rpc": "./rpc.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"deploy": "wrangler deploy",
		"wrangler-typecheck": "wrangler deploy --dry-run",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "oxlint .",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply cloudflare-worker-app --local --persist-to ../../.db/local",
		"db:clean": "rm -rf ../../.db/local",
		"db:reset": "bun run db:clean && bun run db:migrate",
		"db:migrate:prod": "wrangler d1 migrations apply cloudflare-worker-app --remote",
		"db:studio": "DATABASE_URL=file:$(ls ../../.db/local/v3/d1/miniflare-D1DatabaseObject/*.sqlite | head -1) bun run --bun drizzle-kit studio"
	},
	"dependencies": {
		"@hono/trpc-server": "^0.4.1",
		"@hono/zod-validator": "^0.4.3",
		"@trpc/server": "^11.18.0",
		"better-auth": "1.7.0",
		"cloudflare": "^5.2.0",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"hono": "4.10.7",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"superjson": "^2.2.6",
		"ulid": "3.0.2",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.11.1",
		"@cloudflare/workers-types": "^4.20251213.0",
		"@ngneat/falso": "^7.3.0",
		"@trpc/client": "^11.18.0",
		"@types/bun": "^1.3.4",
		"@types/node": "^25.0.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.4",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"globals": "16.5.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.0",
		"vitest": "~3.2.0",
		"wrangler": "4.124.0"
	}
}
