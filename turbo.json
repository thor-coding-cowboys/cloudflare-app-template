{
	"$schema": "https://v2-8-1.turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "**/*.tsbuildinfo"],
			"env": ["BETTER_AUTH_SECRET"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"outputs": []
		},
		"test": {
			"dependsOn": [],
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"wrangler-typecheck": {
			"dependsOn": ["build"],
			"outputs": []
		}
	}
}
